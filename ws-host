#!/bin/sh
# ws-host, the environment orchestrator (0001-ws-host FR-003, 0041-command-line FR-001, 0008-providers FR-008).
# POSIX sh. Needs only sh, tar with xz, and curl or wget; it runs from a fresh clone with no other step, and finds the clone from its own
# location even when run through a symbolic link such as ~/.local/bin/ws-host. Python and uv are not the host's: the first run fetches the
# pinned `mise` (verified by SHA-256 before it is unpacked) and has it install the pinned Python and uv into ws-host's own store, the one
# every provider's programs live in. Everything else is ws_host/: this file only finds the clone, makes sure the runtime is there, and hands over.
#
#   WS_HOST_OFFLINE=1 or --offline   never download anything (exit 3 when the runtime is not already here)
#   WS_HOST_BOOTSTRAP_ONLY=1         make sure the runtime is here and stop (install.sh uses it)
#   WS_HOST_PYTHON=PATH              run this interpreter instead (tests and development only)
#   WS_HOST_MISE=PATH                use this mise instead of the pinned one
#   WS_HOST_MISE_URL=URL             fetch the pinned mise's archive from here (tests); its checksum is still the pinned one
set -eu

self=$0
while [ -h "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd -P)
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$dir/$link ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd -P)

for arg in "$@"; do
  [ "$arg" = "--offline" ] && WS_HOST_OFFLINE=1
done
if [ "${WS_HOST_OFFLINE:-}" = 1 ]; then
  UV_OFFLINE=1
  export UV_OFFLINE WS_HOST_OFFLINE
fi

data=${XDG_DATA_HOME:-$HOME/.local/share}
case $data in /*) ;; *) data=$HOME/.local/share ;; esac
data=$data/workspaces-host
store=$data/mise/data/installs

pin() { sed -n "s/^$1=//p" "$here/ws_host/bootstrap.env" | head -n 1; }

fail() {
  echo "ws-host cannot start: $1" >&2
  echo "$2" >&2
  exit 3
}

runtime_ready() {
  [ -x "$store/python/$py_version/bin/python3" ] && [ -x "$store/uv/$uv_version/.mise-bins/uv" -o -x "$store/uv/$uv_version/uv" ]
}

# Colour and emoji only at a terminal (never with NO_COLOR), so a log stays plain; a slow step shows a spinner and how much it has fetched at a
# terminal, and one plain line anywhere else, so a long download never looks stuck (0006-onboarding FR-020).
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then tty=1; c=$(printf '\033[1;36m'); d=$(printf '\033[2m'); z=$(printf '\033[0m'); else tty=0; c=""; d=""; z=""; fi
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *[Uu][Tt][Ff]*) frames='⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏'; ok='✅'; bad='❌' ;;
  *) frames='| / - \'; ok='ok'; bad='x' ;;
esac

# spin LABEL WATCH COMMAND...: run COMMAND with a spinner, the seconds, and the growth of the folder or file WATCH (kilobytes). Returns its status.
spin() {
  label=$1; watch=$2; shift 2
  if [ "$tty" != 1 ]; then
    echo "$label..." >&2
    "$@"
    return $?
  fi
  base=$(du -sk "$watch" 2>/dev/null | cut -f1); base=${base:-0}
  "$@" &
  pid=$!
  # shellcheck disable=SC2086
  set -- $frames; nframes=$#
  start=$(date +%s); ticks=0
  while kill -0 "$pid" 2>/dev/null; do
    ticks=$((ticks + 1))
    if [ "$ticks" -ge 5 ]; then
      n=$(( ticks % nframes )); f=""; i=0
      for f in $frames; do [ "$i" = "$n" ] && break; i=$((i + 1)); done
      now=$(du -sk "$watch" 2>/dev/null | cut -f1); grown=$(( ${now:-0} - base ))
      extra=""; [ "$grown" -gt 100 ] && extra=" $d$((grown / 1024)) MB$z"
      printf '\r\033[K%s%s%s %s%s %s(%ss)%s' "$c" "$f" "$z" "$label" "$extra" "$d" "$(( $(date +%s) - start ))" "$z" >&2
    fi
    sleep 0.1
  done
  rc=0
  wait "$pid" || rc=$?
  [ "$ticks" -ge 5 ] && printf '\r\033[K' >&2
  if [ "$rc" = 0 ]; then [ "$ticks" -ge 20 ] && printf '%s %s\n' "$ok" "$label" >&2; else printf '%s %s\n' "$bad" "$label" >&2; fi
  return "$rc"
}

fetch_file() {  # fetch_file URL DEST
  if command -v curl >/dev/null 2>&1; then curl -fsSL --retry 3 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then wget -q -O "$2" "$1"
  else return 1; fi
}

bootstrap() {
  [ "${WS_HOST_OFFLINE:-}" = 1 ] && fail "its runtime (Python $py_version and uv $uv_version) is not here yet, and I am not allowed to download it." "Run ws-host once with a network connection."
  mise=${WS_HOST_MISE:-}
  if [ -z "$mise" ]; then
    mise_version=$(pin MISE_VERSION)
    case $(uname -m) in
      x86_64 | amd64) arch=x64; sum=$(pin MISE_SHA256_X86_64) ;;
      aarch64 | arm64) arch=arm64; sum=$(pin MISE_SHA256_AARCH64) ;;
      *) fail "there is no mise for $(uname -m)." "ws-host runs on Linux, x86_64 or aarch64." ;;
    esac
    mise=$data/tools/mise/$mise_version/bin/mise
    if [ ! -x "$mise" ]; then
      cache=${XDG_CACHE_HOME:-$HOME/.cache}/workspaces-host/downloads
      mkdir -p "$cache" "$data/tools/mise"
      file=$cache/$sum
      if [ ! -f "$file" ] || [ "$(sha256sum "$file" | cut -d' ' -f1)" != "$sum" ]; then
        spin "📥 Downloading mise $mise_version, which installs ws-host's tools" "$file.part" \
          fetch_file "${WS_HOST_MISE_URL:-https://mise.jdx.dev/v$mise_version/mise-v$mise_version-linux-$arch.tar.xz}" "$file.part" ||
          fail "mise $mise_version could not be fetched." "Check your network and that curl or wget is installed, then run ws-host again."
        [ "$(sha256sum "$file.part" | cut -d' ' -f1)" = "$sum" ] || { rm -f "$file.part"; fail "the file fetched for mise $mise_version is not the one ws-host expects; nothing was installed." "Run ws-host again; if it repeats, the download is being altered on its way."; }
        mv "$file.part" "$file"
      fi
      tmp=$data/tools/mise/.unpack.$$
      rm -rf "$tmp"; mkdir -p "$tmp"
      tar -xJf "$file" -C "$tmp" --strip-components=1 || { rm -rf "$tmp"; fail "mise could not be unpacked." "Install xz-utils (sudo apt install xz-utils), then run ws-host again."; }
      rm -rf "$data/tools/mise/$mise_version"
      mv "$tmp" "$data/tools/mise/$mise_version"
    fi
  fi
  mkdir -p "$data/mise/data" "${XDG_STATE_HOME:-$HOME/.local/state}/workspaces-host/mise/config"
  for v in $(env | sed -n 's/^\(MISE_[A-Z_]*\)=.*/\1/p'); do unset "$v"; done
  export MISE_DATA_DIR=$data/mise/data MISE_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/workspaces-host/mise \
    MISE_STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/workspaces-host/mise/state \
    MISE_CONFIG_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/workspaces-host/mise/config \
    MISE_SAFE=1 MISE_YES=1 NO_COLOR=1 MISE_QUIET=1
  spin "🐍 Installing ws-host's Python $py_version and uv $uv_version (once)" "$data/mise/data" \
    "$mise" install "python@$py_version" "uv@$uv_version" >&2 ||
    fail "Python and uv could not be installed." "Check your network, then run ws-host again."
}

if [ -n "${WS_HOST_PYTHON:-}" ]; then
  py=$WS_HOST_PYTHON
else
  py_version=$(pin PYTHON_VERSION); uv_version=$(pin UV_VERSION)
  runtime_ready || bootstrap
  py=$store/python/$py_version/bin/python3
  PATH=$store/python/$py_version/bin:$store/uv/$uv_version/.mise-bins:$store/uv/$uv_version:$PATH
  export PATH
fi
[ "${WS_HOST_BOOTSTRAP_ONLY:-}" = 1 ] && exit 0

PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH PYTHONDONTWRITEBYTECODE=1
exec "$py" -m ws_host "$@"
