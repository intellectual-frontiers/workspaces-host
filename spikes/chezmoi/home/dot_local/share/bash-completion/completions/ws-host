# bash completion for ws-host, generated by `ws-host completion add bash`; it is overwritten when ws-host updates it.
_ws_host() {
  local cur="${COMP_WORDS[COMP_CWORD]}" i w skip=0 key pos n noun=0 opts vals
  local -a words=()
  for ((i = 1; i < COMP_CWORD; i++)); do
    w="${COMP_WORDS[i]}"
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$w" in
      --host|--output|--suite) skip=1 ;;
      -*) ;;
      *) words+=("$w") ;;
    esac
  done
  n=${#words[@]}
  if [ "$n" = 0 ]; then
    case "$cur" in
      -*) COMPREPLY=($(compgen -W "--help --version" -- "$cur")) ;;
      *) COMPREPLY=($(compgen -W "auth check command completion context docs doctor fresh help kit repo shell skill test update vscode workspace" -- "$cur")) ;;
    esac
    return
  fi
  case "${words[0]}" in
    auth|command|completion|docs|kit|repo|shell|skill|vscode|workspace) noun=1 ;;
  esac
  if [ "$noun" = 1 ]; then
    if [ "$n" = 1 ]; then
      case "${words[0]}" in
        auth) vals="new status" ;;
        command) vals="list show" ;;
        completion) vals="add list" ;;
        docs) vals="build generate" ;;
        kit) vals="add list show" ;;
        repo) vals="add list set status sync" ;;
        shell) vals="add" ;;
        skill) vals="generate" ;;
        vscode) vals="ensure" ;;
        workspace) vals="ensure set status" ;;
      esac
      COMPREPLY=($(compgen -W "$vals" -- "$cur"))
      return
    fi
    key="${words[0]} ${words[1]}"; pos=$((n - 2))
  else
    key="${words[0]}"; pos=$((n - 1))
  fi
  case "$cur" in
    -*)
      case "$key" in
        "auth new") opts="--debug --dry-run --host --html --json --offline" ;;
        "auth status") opts="--debug --html --json --offline" ;;
        "check") opts="--debug --html --json --offline --suite" ;;
        "command list") opts="--debug --html --json --offline" ;;
        "command show") opts="--debug --html --json --offline" ;;
        "completion add") opts="--debug --dry-run --html --json --offline" ;;
        "completion list") opts="--debug --html --json --offline" ;;
        "context") opts="--debug --html --json --offline" ;;
        "docs build") opts="--debug --dry-run --html --json --offline --output" ;;
        "docs generate") opts="--debug --dry-run --html --json --offline" ;;
        "doctor") opts="--debug --html --json --offline" ;;
        "fresh") opts="--debug --html --json --offline" ;;
        "help") opts="--debug --html --json --offline" ;;
        "kit add") opts="--debug --dry-run --html --json --offline" ;;
        "kit list") opts="--debug --html --json --offline" ;;
        "kit show") opts="--debug --html --json --offline" ;;
        "repo add") opts="--all --debug --dry-run --html --json --offline --trust" ;;
        "repo list") opts="--debug --html --json --offline" ;;
        "repo set") opts="--confirmed --debug --dry-run --html --json --offline --trusted --untrusted" ;;
        "repo status") opts="--debug --html --json --offline" ;;
        "repo sync") opts="--all --debug --dry-run --html --json --offline" ;;
        "shell add") opts="--debug --dry-run --html --json --offline --plain" ;;
        "skill generate") opts="--debug --dry-run --html --json --offline" ;;
        "test") opts="--debug --html --json --offline" ;;
        "update") opts="--background --cached --check --debug --dry-run --html --json --offline" ;;
        "vscode ensure") opts="--debug --dry-run --html --json --offline" ;;
        "workspace ensure") opts="--debug --dry-run --html --json --offline" ;;
        "workspace set") opts="--debug --dry-run --html --json --offline --pull-ff-only" ;;
        "workspace status") opts="--debug --html --json --offline" ;;
        *) opts="--json --html --debug --offline" ;;
      esac
      COMPREPLY=($(compgen -W "$opts" -- "$cur"))
      return ;;
  esac
  case "$key:$pos" in
    "auth new:0") vals="github gitlab" ;;
    "check:0" | "check:1" | "check:2" | "check:3" | "check:4" | "check:5" | "check:6" | "check:7") vals="console fresh help launcher registry specs" ;;
    "completion add:0") vals="bash fish" ;;
    "help:0") vals="ai editor extend kits recover repos shell signin start trust update workspace-file" ;;
    "kit add:0") vals="base press rust shell" ;;
    "kit show:0") vals="base press rust shell" ;;
    "repo add:0") vals="$(ws-host completion list REPO 2>/dev/null | sed -n 's/^  - //p')" ;;
    "repo set:0") vals="$(ws-host completion list REPO 2>/dev/null | sed -n 's/^  - //p')" ;;
    "repo status:0") vals="$(ws-host completion list REPO 2>/dev/null | sed -n 's/^  - //p')" ;;
    "repo sync:0") vals="$(ws-host completion list REPO 2>/dev/null | sed -n 's/^  - //p')" ;;
    "shell add:0") vals="bash fish" ;;
    *) vals="" ;;
  esac
  COMPREPLY=($(compgen -W "$vals" -- "$cur"))
}
complete -F _ws_host ws-host
