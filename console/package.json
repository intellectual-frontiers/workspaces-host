        "key": "ctrl+alt+i w",
        "when": "workspaces-console.hasRepository"
      },
      {
        "command": "workspaces-console.lookForUpdates",
        "key": "ctrl+alt+i u",
        "when": "workspaces-console.hasRepository"
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "%walkthrough.title%",
