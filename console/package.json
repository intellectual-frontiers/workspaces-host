    "taskDefinitions": [
      {
        "type": "workspaces-console",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "%task.command.description%",
            "enum": [
              "check",
              "test",
              "fresh",
              "doctor",
              "build"
            ]
          },
          "section": {
            "type": "string",
            "description": "%task.section.description%"
          },
          "suite": {
            "type": "string",
            "description": "%task.suite.description%"
          },
          "changed": {
            "type": "boolean",
            "description": "%task.changed.description%"
          },
          "folder": {
            "type": "string",
            "description": "%task.folder.description%"
          },
          "build": {
            "type": "string",
            "description": "%task.build.description%"
          }
        }
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "workspaces-console.launchers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "order": 1,
          "markdownDescription": "%setting.launchers.description%"
        },
        "workspaces-console.checkOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 2,
          "markdownDescription": "%setting.checkOnSave.description%"
        },
        "workspaces-console.showAllCommands": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 3,
          "markdownDescription": "%setting.showAllCommands.description%"
        },
        "workspaces-console.rowLimit": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 5000,
          "scope": "application",
          "order": 4,
          "markdownDescription": "%setting.rowLimit.description%"
        },
        "workspaces-console.simpleViews": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 4,
          "markdownDescription": "%setting.simpleViews.description%"
        },
        "workspaces-console.showWelcomeOnStart": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 5,
          "markdownDescription": "%setting.showWelcomeOnStart.description%"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "workspaces-console.servers",
        "label": "%mcp.label%"
      }
    ],
    "keybindings": [
      {
        "command": "workspaces-console.showHome",
        "key": "ctrl+alt+i h",
        "when": "workspaces-console.hasRepository"
      },
      {
        "command": "workspaces-console.check",
        "key": "ctrl+alt+i c",
        "when": "workspaces-console.hasRepository"
